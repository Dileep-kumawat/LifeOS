# ==============================================================================
# LifeOS Environment Configuration Template
# ==============================================================================
# IMPORTANT: Never commit actual secrets or production keys to version control.
# Copy this file to .env or workspace-specific .env files (e.g. api/.env) and
# configure real credentials for each target deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'test', or 'production'
# REQUIRED in all environments.
NODE_ENV=development

# REST API & WebSocket server listen port. Defaults to 4000 if omitted.
PORT=4000

# Allowed Web Client Origin for CORS and cookie credentials.
# In production, set to your production web domain (e.g., https://app.lifeos.com).
# REQUIRED in production.
CORS_ORIGIN=http://localhost:5173

# Public frontend application URL (used for email redirects and OAuth bridges).
# REQUIRED in production.
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE & CACHE INFRASTRUCTURE
# ------------------------------------------------------------------------------
# MongoDB connection URI.
# Local Docker: mongodb://mongo:27017/lifeos
# Local Host:   mongodb://localhost:27017/lifeos_dev
# Production:   mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/lifeos_prod?retryWrites=true&w=majority
# REQUIRED in all environments.
MONGO_URI=mongodb://localhost:27017/lifeos_dev

# Redis connection URI (used for BullMQ background queues, rate limiting, and Socket.IO adapter).
# Local Docker: redis://redis:6379
# Local Host:   redis://localhost:6379
# Production:   rediss://default:<password>@redis.example.com:6379 (TLS required in prod)
# REQUIRED in all environments.
REDIS_URL=redis://localhost:6379

# MongoDB Atlas Vector Search Index name for AI RAG embeddings (default: vector_index)
MONGO_VECTOR_INDEX=vector_index

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION TOKENS (NFR-2.2, NFR-2.3)
# ------------------------------------------------------------------------------
# HMAC-SHA256 secret key for signing short-lived (15 min) JWT Access Tokens.
# Must be at least 16 characters (recommended: 64 random bytes hex/base64).
# REQUIRED in all environments.
JWT_ACCESS_SECRET=dev-access-secret-change-me-min16chars-required

# HMAC-SHA256 secret key for signing rotating Refresh Tokens.
# Must be at least 16 characters (recommended: 64 random bytes hex/base64).
# REQUIRED in all environments.
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min16chars-required

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 & IDENTITY VERIFICATION (FR-1.1)
# ------------------------------------------------------------------------------
# Web Client ID from Google Cloud Console credentials.
# Required in production if Google Sign-In is enabled.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Web Client Secret from Google Cloud Console.
# Required in production if Google OAuth web redirect flow is enabled.
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Fully-qualified OAuth 2.0 callback URL registered in Google Cloud Console.
# Default: http://localhost:4000/api/v1/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Optional Client IDs for native mobile verification (iOS / Android)
GOOGLE_MOBILE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ------------------------------------------------------------------------------
# 5. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
# Web Push VAPID keys for browser notifications.
# The API fails fast on boot if any of these are missing.
# Generate a fresh pair using: npx web-push generate-vapid-keys
# REQUIRED in all environments.
VAPID_PUBLIC_KEY=replace-with-generated-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-generated-vapid-private-key
VAPID_SUBJECT=mailto:admin@lifeos.example.com

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL PROVIDERS (OPTIONAL)
# ------------------------------------------------------------------------------
# Required only if password reset / email verification emails are sent via external APIs.
RESEND_API_KEY=
POSTMARK_API_KEY=

# ------------------------------------------------------------------------------
# 7. THIRD-PARTY AI PROVIDERS & LLMS (NFR-6.2)
# ------------------------------------------------------------------------------
# Fallback provider chain order. Comma-separated: mistral,groq,gemini
AI_PROVIDER_ORDER=mistral,groq,gemini

# Primary Provider: Mistral AI (https://console.mistral.ai)
MISTRAL_API_KEY=

# Secondary Fallback: Groq Cloud LPUs (https://console.groq.com)
GROQ_API_KEY=

# Tertiary Fallback: Google Gemini API (https://aistudio.google.com)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional Google Cloud Vision API key for receipt OCR extraction fallback
GOOGLE_VISION_API_KEY=

# Retention window in days for raw AI prompt/response log documents (default: 90)
AI_LOG_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 8. SECURITY, AUDIT & OBSERVABILITY (NFR-2.4, NFR-2.6)
# ------------------------------------------------------------------------------
# Comma-separated IP allowlist for Swagger API documentation (/api/v1/docs).
# In production and test, Swagger is gated behind this list. If empty, Swagger is disabled.
# Local development stays accessible without restriction.
SWAGGER_ALLOWED_IPS=

# Security audit log retention period in days (default: 90, enforced via MongoDB TTL index).
AUDIT_LOG_RETENTION_DAYS=90

# Sentry DSN for application performance monitoring and exception tracking.
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 9. DATABASE BACKUP & DISASTER RECOVERY (NFR-3.3)
# ------------------------------------------------------------------------------
# Filesystem directory for local database snapshots (default: ./backups)
BACKUP_DIR=./backups

# 256-bit (64-character hexadecimal) encryption key for AES-256-GCM snapshot encryption.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# If omitted, snapshots remain unencrypted gzip archives.
BACKUP_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 10. FRONTEND & MOBILE CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Web Vite backend API URL (leave blank in dev to use Vite proxy; set in Vercel to Render URL):
# VITE_API_URL=https://lifeos-api-xxxx.onrender.com
# VITE_VAPID_PUBLIC_KEY=replace-with-generated-vapid-public-key
# VITE_SENTRY_DSN=

# Mobile Expo API URL override (leave blank to auto-detect LAN IP or adb reverse):
# EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
