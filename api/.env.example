NODE_ENV=development
PORT=4000

# Local dev values match docker-compose.yml service names.
# If running the API outside Docker (npm run dev on host), use:
#   MONGO_URI=mongodb://localhost:27017/lifeos
#   REDIS_URL=redis://localhost:6379
MONGO_URI=mongodb://mongo:27017/lifeos
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

CORS_ORIGIN=http://localhost:5173

# Optional — leave blank locally, set in CI/staging/prod
SENTRY_DSN=

# Web Push VAPID keys (Phase 2 notifications) — REQUIRED, the API fails fast
# on boot if missing. Generate a fresh pair with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=BJeOVwe0q4eGgKJxmQVNKbnS8jq5zL3XGnWSBxdTWhw9qk_11212xzbgEatEOrF15aP6C8JUM8U9776luUqY2jI
VAPID_PRIVATE_KEY=U1kOcjWcDP-m8Bg9YnKcxQwdkEkbMWO3_e0mbgJXnxE
VAPID_SUBJECT=mailto:dileepkumawat525@gmail.com

# Optional — only needed once the Google OAuth strategy is enabled (Phase 10)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase 3 AI Provider Config & Keys
AI_PROVIDER_ORDER=mistral,groq,gemini
MISTRAL_API_KEY=
GROQ_API_KEY=
