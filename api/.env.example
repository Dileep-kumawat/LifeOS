# ==============================================================================
# LifeOS API Environment Configuration Template
# ==============================================================================
# Copy this file to api/.env for local API development.
# ==============================================================================

NODE_ENV=development
PORT=4000

# Database & Cache (match docker-compose.yml or host setup)
# Docker: mongodb://mongo:27017/lifeos | Host: mongodb://localhost:27017/lifeos_dev
MONGO_URI=mongodb://localhost:27017/lifeos_dev
REDIS_URL=redis://localhost:6379
MONGO_VECTOR_INDEX=vector_index

# Authentication & Session Security (min 16 chars required)
JWT_ACCESS_SECRET=dev-access-secret-change-me-min16chars-required
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min16chars-required

# Client URLs & CORS
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Sentry Exception Tracking (optional locally, recommended in production)
SENTRY_DSN=

# Transactional Email (optional)
RESEND_API_KEY=
POSTMARK_API_KEY=

# Web Push VAPID keys (REQUIRED - API fails fast on boot if missing)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace-with-generated-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-generated-vapid-private-key
VAPID_SUBJECT=mailto:admin@lifeos.example.com

# Google OAuth 2.0 (FR-1.1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_MOBILE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Swagger Production Security (/api/v1/docs restricted in prod/test)
SWAGGER_ALLOWED_IPS=

# Third-Party AI Providers & LLMs (NFR-6.2)
AI_PROVIDER_ORDER=mistral,groq,gemini
MISTRAL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_VISION_API_KEY=
AI_LOG_RETENTION_DAYS=90

# Security Audit Logging (NFR-2.6)
AUDIT_LOG_RETENTION_DAYS=90

# Database Backup & Disaster Recovery (NFR-3.3)
BACKUP_DIR=./backups
BACKUP_ENCRYPTION_KEY=
