NODE_ENV=development
PORT=4000

# Local dev values match docker-compose.yml service names.
# If running the API outside Docker (npm run dev on host), use:
#   MONGO_URI=mongodb://localhost:27017/lifeos
#   REDIS_URL=redis://localhost:6379
MONGO_URI=mongodb://mongo:27017/lifeos
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

CORS_ORIGIN=http://localhost:5173

# Optional — leave blank locally, set in CI/staging/prod
SENTRY_DSN=

# Optional — only needed once the Google OAuth strategy is enabled (Phase 10)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
