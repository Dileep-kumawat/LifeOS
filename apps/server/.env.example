PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/lifeos

# JWT
JWT_SECRET=super-secret-lifeos-jwt-key-2026-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-lifeos-refresh-token-key-2026
JWT_REFRESH_EXPIRES_IN=7d

# CORS & App URLs
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Session (used only for OAuth handshake)
SESSION_SECRET=super-secret-lifeos-session-key-2026

# Google OAuth 2.0 (Passport.js)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

LOG_LEVEL=info
