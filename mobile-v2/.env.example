# ==============================================================================
# LifeOS Mobile-v2 (Capacitor) Environment Configuration
# ==============================================================================

# Target Web Application URL rendered inside the full-bleed WebView:
# Development (Android Emulator): http://10.0.2.2:5173
# Development (Physical Device with USB adb reverse): http://localhost:5173
# Production: Set to your deployed web domain (e.g. https://lifeos.vercel.app)
CAPACITOR_WEB_URL=http://10.0.2.2:5173

# Development Mode Flag ("true" | "false")
# Enables WebView debugging (chrome://inspect) and dev server cleartext traffic
CAPACITOR_DEV=true

# Development host override if not using default 10.0.2.2:5173
CAPACITOR_DEV_URL=http://10.0.2.2:5173

# Backend REST API endpoint for native push token registration & OAuth initiation
# Development: http://10.0.2.2:4000/api/v1
# Production:  https://lifeos-api-hqcz.onrender.com/api/v1
VITE_API_URL=http://10.0.2.2:4000/api/v1
