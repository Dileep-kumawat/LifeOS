# ==============================================================================
# LifeOS Mobile Client Environment Configuration
# ==============================================================================
#
# SINGLE VARIABLE ENVIRONMENT SWITCHING:
# Change EXPO_PUBLIC_APP_ENV to either "development" or "production":
#
#   development - Connects to local dev backend:
#                 - Wi-Fi: Auto-detects your laptop/machine IP (e.g. http://192.168.x.x:4000/api/v1)
#                 - USB / Simulator / Web: http://localhost:4000/api/v1 (use adb reverse tcp:4000 tcp:4000)
#
#   production  - Connects to deployed Render API server:
#                 - Base API: https://lifeos-api-hqcz.onrender.com/api/v1
#                 - WebSockets / Chat: https://lifeos-api-hqcz.onrender.com
#                 - Google OAuth: https://lifeos-api-hqcz.onrender.com
#
EXPO_PUBLIC_APP_ENV=development

# Optional override: If you ever want to point to a custom API URL regardless of mode
# EXPO_PUBLIC_API_URL=https://lifeos-api-hqcz.onrender.com/api/v1
