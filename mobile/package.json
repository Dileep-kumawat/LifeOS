{
  "name": "@lifeos/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eas-build-post-install": "npm run build --prefix ../packages/shared && node -e \"const fs=require('fs');const path=require('path');const s=path.resolve('../packages/shared/dist');const d=path.resolve('node_modules/@lifeos/shared/dist');if(fs.existsSync(s)){fs.mkdirSync(d,{recursive:true});fs.cpSync(s,d,{recursive:true});}\""
  },
  "dependencies": {
    "@lifeos/shared": "file:../packages/shared",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@tanstack/react-query": "^5.56.2",
    "axios": "^1.7.7",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.1",
    "expo-blur": "~14.0.1",
    "expo-constants": "~17.0.0",
    "expo-font": "~13.0.1",
    "expo-haptics": "~14.0.0",
    "expo-linear-gradient": "~14.0.1",
    "expo-secure-store": "~14.0.0",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "lucide-react-native": "^0.441.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "socket.io-client": "^4.8.3",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
