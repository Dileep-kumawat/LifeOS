{
  "name": "lifeos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "api",
    "web",
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "dev:mobile": "npm run start --workspace=mobile",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=api && npm run build --workspace=web",
    "build:shared": "npm run build --workspace=packages/shared",
    "postinstall": "npm run build --workspace=packages/shared",
    "eas-build-post-install": "npm run build --workspace=packages/shared",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspace=api && npm run typecheck --workspace=web && npm run typecheck --workspace=packages/shared && npm run typecheck --workspace=mobile",
    "test": "npm run test --workspace=api --if-present && npm run test --workspace=web --if-present && npm run test --workspace=mobile --if-present",
    "check:openapi": "tsx scripts/check-openapi-coverage.ts"
  },
  "dependencies": {
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "@types/react": "~18.3.12",
    "@types/react-dom": "~18.3.1",
    "@react-native/virtualized-lists": "0.76.9"
  }
}
