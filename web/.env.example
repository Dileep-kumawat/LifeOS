# ==============================================================================
# LifeOS Web Client Environment Variables Template
# ==============================================================================

# Backend API server base URL.
# In local development: Leave blank to use Vite's proxy (targets http://localhost:4000)
# In production on Vercel: Set to your live Render backend URL, e.g.:
# VITE_API_URL=https://lifeos-api-xxxx.onrender.com
VITE_API_URL=

# Web Push VAPID public key (must match backend VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=

# Sentry DSN for error monitoring (optional)
VITE_SENTRY_DSN=
